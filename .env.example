# Copy this file to  .env  and fill it in.  .env is NOT committed (listed in .gitignore).
#
# Path to the Viber SQLCipher database. Supports ~ and environment variables
# (e.g. ~/AppData/... or %APPDATA%/...).
# Leave empty to auto-detect at  %APPDATA%\ViberPC\<number>\viber.db
VIBER_DB=

# Your own Viber account number (the folder name under ViberPC). If empty, it is
# derived from VIBER_DB. Used to tell apart who sent (OUT) vs received (IN).
VIBER_SELF_NUMBER=

# --- The following is only needed for the offline 'open' method ---
# (works on older Viber versions where the raw key opens the DB directly).
# Capture them with:  python viber.py hookkey
VIBER_HEXKEY=
VIBER_SALT=
